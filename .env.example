# ============================================================================
# Chat with Your Documents - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# ============================================================================

# ----------------------------------------------------------------------------
# API Keys
# ----------------------------------------------------------------------------

# OpenAI API Key (required for OpenAI embeddings and LLM)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace API Key (optional, for private models)
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ----------------------------------------------------------------------------
# Embedding Configuration
# ----------------------------------------------------------------------------

# Embedding provider: "openai" or "huggingface"
# HuggingFace runs locally (no API key needed for public models)
EMBEDDING_PROVIDER=huggingface

# OpenAI embedding model (if using OpenAI)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# HuggingFace embedding model (if using HuggingFace)
# Default: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions, fast, good quality)
# Alternative: sentence-transformers/all-mpnet-base-v2 (768 dimensions, better quality)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding dimension (should match your model)
EMBEDDING_DIMENSION=384

# Enable embedding caching to avoid recomputation
EMBEDDING_CACHE_ENABLED=true

# ----------------------------------------------------------------------------
# Chunking Configuration
# ----------------------------------------------------------------------------

# Target chunk size in characters (approximately 4 chars = 1 token)
# Larger chunks = more context, but may include irrelevant info
# Smaller chunks = more precise, but may lose context
CHUNK_SIZE=800

# Overlap between consecutive chunks
# Helps maintain context across chunk boundaries
CHUNK_OVERLAP=150

# ----------------------------------------------------------------------------
# Retrieval Configuration
# ----------------------------------------------------------------------------

# Number of chunks to retrieve for each query
# Higher = more context but may include less relevant info
RETRIEVER_TOP_K=3

# Minimum similarity score (0-1) to include a chunk
# 0 = include all, higher = more strict filtering
SIMILARITY_THRESHOLD=0.0

# Search type: "similarity" or "mmr" (maximal marginal relevance)
# MMR helps reduce redundancy in retrieved chunks
SEARCH_TYPE=similarity

# ----------------------------------------------------------------------------
# LLM Configuration
# ----------------------------------------------------------------------------

# LLM provider: "openai" or "huggingface"
LLM_PROVIDER=openai

# OpenAI model (if using OpenAI)
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview
OPENAI_MODEL=gpt-3.5-turbo

# HuggingFace model (if using local inference)
# Note: Large models require significant RAM
HUGGINGFACE_LLM_MODEL=google/flan-t5-base

# Temperature for generation
# 0 = deterministic (best for factual Q&A)
# 0.7 = more creative
LLM_TEMPERATURE=0

# Maximum tokens in LLM response
LLM_MAX_TOKENS=512
